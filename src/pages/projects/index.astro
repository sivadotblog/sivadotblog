---
import Layout from '~/layouts/PageLayout.astro';
import Headline from '~/components/blog/Headline.astro';
import Grid from '~/components/projects/Grid.astro';

import { fetchProjects } from '~/utils/projects';

export const prerender = true;

const projects = await fetchProjects();

const metadata = {
  title: 'Projects',
  description: "Things I've built and am building.",
};
---

<Layout metadata={metadata}>
  <section class="px-4 md:px-6 py-12 md:py-16 lg:py-20 mx-auto max-w-7xl">
    <Headline subtitle="Things I've built and am building.">Projects</Headline>
    <Grid projects={projects} />
  </section>
</Layout>
